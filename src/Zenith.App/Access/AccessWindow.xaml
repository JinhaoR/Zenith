<Window x:Class="Zenith.App.Access.AccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary access — Zenith" Width="570" Height="650" MinWidth="480" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ZenithWindowBrush}" Foreground="{DynamicResource ZenithTextBrush}"
        FontFamily="Segoe UI" FontSize="14" SourceInitialized="Window_OnSourceInitialized"
        Closed="Window_OnClosed" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Zenith.App;component/Settings/SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource ZenithRaisedSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ZenithTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ZenithInteractiveBorderBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource ZenithAccentBrush}" />
                <Setter Property="Padding" Value="12" /><Setter Property="MaxLength" Value="128" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,30">
            <TextBlock Text="TEMPORARY ACCESS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ZenithAccentBrush}" />
            <TextBlock x:Name="Heading" Text="A deliberate visit" FontSize="27" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock x:Name="Explanation" Margin="0,12,0,24" Style="{StaticResource Description}" />
            <Border x:Name="TargetCard" Style="{StaticResource Card}" Padding="18">
                <StackPanel><TextBlock x:Name="HostText" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ScopeText" Margin="0,8,0,0" Style="{StaticResource Description}" FontSize="12" /></StackPanel>
            </Border>
            <Border x:Name="ProgressCard" Style="{StaticResource Card}" Padding="18">
                <StackPanel><TextBlock x:Name="ProgressText" FontWeight="SemiBold" /><TextBlock x:Name="TimingText" Margin="0,8,0,0" Style="{StaticResource Description}" /></StackPanel>
            </Border>
            <StackPanel x:Name="PasswordPanel">
                <Label Target="{Binding ElementName=Password}" Content="Password" Foreground="{DynamicResource ZenithTextBrush}" Padding="0,0,0,8" />
                <PasswordBox x:Name="Password" AutomationProperties.Name="Access password" />
                <StackPanel x:Name="ConfirmationPanel" Margin="0,16,0,0">
                    <Label Target="{Binding ElementName=Confirmation}" Content="Confirm password" Foreground="{DynamicResource ZenithTextBrush}" Padding="0,0,0,8" />
                    <PasswordBox x:Name="Confirmation" AutomationProperties.Name="Confirm access password" />
                    <TextBlock Text="Use 15–128 characters. Keep this password safe: changing it through the Vault requires the current password. Forgotten-password recovery is not available." Margin="0,12,0,0" FontSize="12" Style="{StaticResource Description}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Margin="0,16,0,0" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel Margin="0,20,0,0">
                <Button x:Name="SubmitButton" Content="Continue" Click="Submit_OnClick" Background="{DynamicResource ZenithAccentBrush}" Foreground="{DynamicResource ZenithAccentForegroundBrush}" Margin="0,0,12,10" />
                <Button Content="Return to browsing" Click="Close_OnClick" Margin="0,0,0,10" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
