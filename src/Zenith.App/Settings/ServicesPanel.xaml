<UserControl x:Class="Zenith.App.Settings.ServicesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Service registry">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zenith.App;component/Settings/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
            <DataTemplate x:Key="DomainDetails">
                <StackPanel Margin="0,10,0,14">
                    <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Description}" />
                    <TextBlock Text="{Binding RequiredLabel}" Style="{StaticResource Description}" />
                    <TextBlock Text="{Binding Classification, StringFormat=Dependency classification: {0}}" Style="{StaticResource Description}" />
                    <TextBlock Text="{Binding Applicability, StringFormat=Permission applicability: {0}}" Style="{StaticResource Description}" />
                    <Expander Header="Relationship evidence" Margin="0,6,0,0" Foreground="{DynamicResource ZenithTextBrush}">
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource Description}" Margin="12,6,0,0" />
                    </Expander>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ServiceDetails">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Description}" />
                        <TextBlock Text="{Binding MembershipLabel}" Style="{StaticResource Description}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Description}" Margin="0,12,0,16" />
                        <TextBlock Text="Capabilities" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,6,0,16">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Description}" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Shared infrastructure" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DependencySummary}" Style="{StaticResource Description}" Margin="0,6,0,16" />
                        <Button Content="Add to Sphere…" Click="Prepare_OnClick" HorizontalAlignment="Left" Margin="0,0,0,16"
                                Visibility="{Binding DataContext.CanPrepareSelectedService, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhenTrue}}" />
                        <Expander Header="Technical details" Foreground="{DynamicResource ZenithTextBrush}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding StatusDescription}" Style="{StaticResource Description}" />
                                <TextBlock Text="These relationships describe the catalog. They are not permissions or a complete list of dependencies." Style="{StaticResource Description}" Margin="0,8,0,12" />
                                <TextBlock Text="Declared service domains" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Domains}" ItemTemplate="{StaticResource DomainDetails}" />
                                <ItemsControl ItemsSource="{Binding Infrastructure}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,8,0,12">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Description}" />
                                            <Expander Header="Service-to-infrastructure evidence" Margin="0,8,0,0" Foreground="{DynamicResource ZenithTextBrush}">
                                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource Description}" Margin="12,6,0,0" />
                                            </Expander>
                                            <ItemsControl ItemsSource="{Binding Domains}" ItemTemplate="{StaticResource DomainDetails}" />
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Capability descriptions" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Capabilities}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,6,0,8">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Description}" />
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Description}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
        <Button Content="Try loading again" Click="Retry_OnClick" HorizontalAlignment="Left" Margin="0,0,0,12"
                Visibility="{Binding CanRetry, Converter={StaticResource VisibleWhenTrue}}" />
        <Expander Header="Catalog diagnostics" Margin="0,0,0,12" Foreground="{DynamicResource ZenithTextBrush}"
                  Visibility="{Binding HasDiagnostics, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource Description}" Margin="12,6,0,0" />
        </Expander>
        <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="Find a service" FontWeight="SemiBold" />
            <TextBox x:Name="ServiceSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,8,0,6"
                     AutomationProperties.Name="Search the local service registry" ToolTip="Filter local service names or categories; does not search the web" />
            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Description}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource SettingsScrollViewerStyle}" Margin="0,0,0,18">
                <ItemsControl x:Name="ServiceCategories" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding DisplayName}" Tag="{Binding}" Click="Service_OnClick" HorizontalAlignment="Left"
                                            Margin="0,0,0,5" AutomationProperties.Name="{Binding DisplayName, StringFormat=Show details for {0}}" />
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Select a service to read its details." Style="{StaticResource Description}" Margin="0,0,0,10" />
            <ContentControl x:Name="Details" Content="{Binding SelectedService}" ContentTemplate="{StaticResource ServiceDetails}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <TextBlock Text="{Binding ProposalError}" Style="{StaticResource Description}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
            <Border Style="{StaticResource Card}" Visibility="{Binding HasProposal, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                    <TextBlock Text="Review service access" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProposalSummary}" Margin="0,12,0,16" />
                    <TextBlock Text="Optional access (unselected by default)" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding OptionalScopes}" Margin="0,6,0,12">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Click="Optional_OnClick"><TextBlock Text="{Binding Label}" /></CheckBox>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Frozen proposal details" Foreground="{DynamicResource ZenithTextBrush}" Margin="0,0,0,16">
                        <TextBlock Text="{Binding ProposalDetails}" Style="{StaticResource Description}" Margin="0,8,0,0" />
                    </Expander>
                    <Button Content="Continue to Vault review" IsEnabled="{Binding CanContinue}" Click="Continue_OnClick" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding RegistryRevision, StringFormat=Catalog revision: {0}}" Style="{StaticResource Description}" Margin="0,8,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
