<UserControl x:Class="Zenith.App.Settings.VaultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Zenith.App;component/Settings/SettingsControls.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ZenithRaisedSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ZenithTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ZenithInteractiveBorderBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource ZenithAccentBrush}" /><Setter Property="Padding" Value="12" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource ZenithRaisedSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ZenithTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ZenithInteractiveBorderBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource ZenithAccentBrush}" /><Setter Property="Padding" Value="12" /><Setter Property="MaxLength" Value="128" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Your active rules" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ActiveSummary" Style="{StaticResource Description}" Margin="0,10,0,0" />
            <TextBlock x:Name="TestingNotice" Text="Development timing: five-second values are for testing. Increase them here when you are ready for longer waits." Style="{StaticResource Description}" Margin="0,12,0,0" />
            <TextBlock x:Name="HealthText" Style="{StaticResource Description}" Margin="0,12,0,0" />
            <Button x:Name="SetupButton" Content="Set up your password" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Setup_OnClick" Visibility="Collapsed" />
        </StackPanel></Border>
        <StackPanel x:Name="WorkArea">
            <Border x:Name="PendingCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
                <TextBlock Text="Pending change" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="PendingSummary" Style="{StaticResource Description}" Margin="0,12,0,0" />
                <TextBlock x:Name="Countdown" Foreground="{DynamicResource ZenithAccentBrush}" Margin="0,16,0,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Nothing changes automatically. Return and confirm this exact proposal with your current password." Style="{StaticResource Description}" Margin="0,8,0,12" />
                <Label Content="Current password" Target="{Binding ElementName=ConfirmPassword}" Foreground="{DynamicResource ZenithTextBrush}" Padding="0,0,0,8" />
                <PasswordBox x:Name="ConfirmPassword" AutomationProperties.Name="Current password to confirm proposal" />
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="ConfirmButton" Content="Confirm and apply" Click="Confirm_OnClick" Margin="0,0,10,10" />
                    <Button x:Name="EditButton" Content="Edit proposal" Click="Edit_OnClick" Margin="0,0,10,10" />
                    <Button x:Name="CancelButton" Content="Cancel proposal" Click="Cancel_OnClick" Margin="0,0,0,10" />
                </WrapPanel>
            </StackPanel></Border>
            <StackPanel x:Name="Editor">
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Waiting periods &amp; visit duration" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Greylist waits and visits can range from 5 seconds to 24 hours. Vault waits can range from 5 seconds to 30 days. Changing a wait must still follow your current Vault rules." Style="{StaticResource Description}" Margin="0,10,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Label Content="Greylist waiting period" Target="{Binding ElementName=GreySeconds}" Foreground="{DynamicResource ZenithTextBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="GreySeconds" Grid.Column="1" MaxLength="7" Margin="0,0,0,8" AutomationProperties.Name="Greylist waiting period value" />
                        <ComboBox x:Name="GreyUnit" Grid.Column="2" Margin="8,0,0,8" SelectedIndex="0" AutomationProperties.Name="Greylist wait unit">
                            <ComboBoxItem Content="seconds" Tag="1" /><ComboBoxItem Content="minutes" Tag="60" /><ComboBoxItem Content="hours" Tag="3600" /><ComboBoxItem Content="days" Tag="86400" />
                        </ComboBox>
                        <Label Grid.Row="1" Content="Temporary visit duration" Target="{Binding ElementName=GrantSeconds}" Foreground="{DynamicResource ZenithTextBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="GrantSeconds" Grid.Row="1" Grid.Column="1" MaxLength="7" Margin="0,0,0,8" AutomationProperties.Name="Temporary visit duration value" />
                        <ComboBox x:Name="GrantUnit" Grid.Row="1" Grid.Column="2" Margin="8,0,0,8" SelectedIndex="0" AutomationProperties.Name="Visit duration unit">
                            <ComboBoxItem Content="seconds" Tag="1" /><ComboBoxItem Content="minutes" Tag="60" /><ComboBoxItem Content="hours" Tag="3600" /><ComboBoxItem Content="days" Tag="86400" />
                        </ComboBox>
                        <Label Grid.Row="2" Content="Vault waiting period" Target="{Binding ElementName=VaultSeconds}" Foreground="{DynamicResource ZenithTextBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="VaultSeconds" Grid.Row="2" Grid.Column="1" MaxLength="7" AutomationProperties.Name="Vault waiting period value" />
                        <ComboBox x:Name="VaultUnit" Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" SelectedIndex="0" AutomationProperties.Name="Vault wait unit">
                            <ComboBoxItem Content="seconds" Tag="1" /><ComboBoxItem Content="minutes" Tag="60" /><ComboBoxItem Content="hours" Tag="3600" /><ComboBoxItem Content="days" Tag="86400" />
                        </ComboBox>
                    </Grid>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Add to your Sphere" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Optional: enter one hostname, such as example.com. Paths and credentials are not accepted. Blacklist restrictions always remain active." Style="{StaticResource Description}" Margin="0,10,0,14" />
                    <TextBox x:Name="SiteHost" MaxLength="253" AutomationProperties.Name="Hostname to add to your Sphere" />
                    <CheckBox x:Name="IncludeSubdomains" Content="Also include subdomains" Foreground="{DynamicResource ZenithTextBrush}" Margin="0,14,0,0" />
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <CheckBox x:Name="ChangePassword" Content="Change my password" Foreground="{DynamicResource ZenithTextBrush}" FontSize="18" />
                    <TextBlock Text="Optional: enter and repeat a new password of 15–128 characters. Your old password remains active until you confirm after the wait. This is not forgotten-password recovery." Style="{StaticResource Description}" Margin="0,12,0,14" />
                    <Label Content="New password" Target="{Binding ElementName=NewPassword}" Foreground="{DynamicResource ZenithTextBrush}" Padding="0,0,0,8" />
                    <PasswordBox x:Name="NewPassword" AutomationProperties.Name="Proposed new password" />
                    <Label Content="Repeat new password" Target="{Binding ElementName=RepeatPassword}" Foreground="{DynamicResource ZenithTextBrush}" Padding="0,14,0,8" />
                    <PasswordBox x:Name="RepeatPassword" AutomationProperties.Name="Repeat proposed new password" />
                </StackPanel></Border>
                <Button x:Name="ReviewButton" Content="Review changes" Click="Review_OnClick" HorizontalAlignment="Left" Margin="0,0,0,16" />
                <Border x:Name="ReviewCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
                    <TextBlock Text="Review before you begin" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReviewSummary" Style="{StaticResource Description}" Margin="0,12,0,14" />
                    <TextBlock Text="Staging replaces any pending proposal and starts the full current Vault wait again. Existing Greylist waits keep their recorded deadlines." Style="{StaticResource Description}" Margin="0,0,0,14" />
                    <Label Content="Current password" Target="{Binding ElementName=StagePassword}" Foreground="{DynamicResource ZenithTextBrush}" Padding="0,0,0,8" />
                    <PasswordBox x:Name="StagePassword" AutomationProperties.Name="Current password to stage proposal" />
                    <Button x:Name="StageButton" Content="Authenticate and start wait" Click="Stage_OnClick" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel></Border>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="OutcomeText" Style="{StaticResource Description}" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
