<Window x:Class="Zenith.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:Zenith.App.Settings"
        Title="Settings — Zenith" Width="960" Height="740" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ZenithWindowBrush}" Foreground="{DynamicResource ZenithTextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        SourceInitialized="Window_OnSourceInitialized" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Zenith.App;component/Settings/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource ZenithWindowBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ZenithChromeBrush}" BorderBrush="{DynamicResource ZenithBorderBrush}" BorderThickness="0,0,1,0" Padding="18,28,18,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,0,0,28">
                    <TextBlock Text="Z E N I T H" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZenithAccentBrush}" />
                    <TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold" Margin="0,12,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,20,6,0">
                    <TextBlock Text="A space that feels like yours." FontSize="12" Style="{StaticResource Description}" />
                    <Button Content="Return to browsing" Margin="0,14,0,0" Padding="8,10" Click="Close_OnClick" />
                </StackPanel>
                <ListBox x:Name="Sections" Background="Transparent" BorderThickness="0" SelectionChanged="Sections_OnSelectionChanged" AutomationProperties.Name="Settings sections">
                    <ListBoxItem Tag="General" Content="General" />
                    <ListBoxItem Tag="Sphere" Content="Your Sphere" />
                    <ListBoxItem Tag="Access" Content="Temporary access" />
                    <ListBoxItem Tag="Vault" Content="Vault" />
                    <ListBoxItem Tag="About" Content="About Zenith" />
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="36,30,36,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,26">
                <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="PageDescription" Margin="0,8,0,0" Style="{StaticResource Description}" />
            </StackPanel>
            <ScrollViewer x:Name="PageScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                <Grid>
                    <StackPanel x:Name="GeneralPage">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Make yourself at home" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Choose how the sidebar looks when you open Zenith." Margin="0,8,0,0" Style="{StaticResource Description}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <RadioButton x:Name="ExpandedOption" Content="Expanded sidebar" GroupName="Sidebar" Checked="Preferences_OnChanged" />
                                    <RadioButton x:Name="CompactOption" Content="Compact sidebar" GroupName="Sidebar" Checked="Preferences_OnChanged" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Page size" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Default zoom for pages. Applies to open tabs and new tabs." Margin="0,8,0,16" Style="{StaticResource Description}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ZoomOutButton" Content="−" Width="44" Padding="0,9" AutomationProperties.Name="Decrease default page zoom" Click="ZoomOut_OnClick" />
                                    <TextBlock x:Name="ZoomValue" Width="82" TextAlignment="Center" VerticalAlignment="Center" FontSize="18" />
                                    <Button x:Name="ZoomInButton" Content="+" Width="44" Padding="0,9" AutomationProperties.Name="Increase default page zoom" Click="ZoomIn_OnClick" />
                                    <Button Content="Reset to 100%" Margin="16,0,0,0" Click="ResetZoom_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Midnight" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,14">
                                    <Border Width="44" Height="30" CornerRadius="8" Background="{DynamicResource ZenithWindowBrush}" Margin="0,0,8,0" />
                                    <Border Width="44" Height="30" CornerRadius="8" Background="{DynamicResource ZenithRaisedSurfaceBrush}" Margin="0,0,8,0" />
                                    <Border Width="44" Height="30" CornerRadius="8" Background="{DynamicResource ZenithAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="Zenith’s calm, midnight palette. Windows High Contrast takes precedence automatically." Style="{StaticResource Description}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="SpherePage" Visibility="Collapsed">
                        <TextBox x:Name="SiteFilter" Padding="14,12" Margin="0,0,0,18" Background="{DynamicResource ZenithSurfaceBrush}" Foreground="{DynamicResource ZenithTextBrush}" BorderBrush="{DynamicResource ZenithBorderBrush}" CaretBrush="{DynamicResource ZenithAccentBrush}" AutomationProperties.Name="Filter sites in your Sphere" ToolTip="Filter by site name or hostname" TextChanged="SiteFilter_OnTextChanged" />
                        <ItemsControl x:Name="SiteList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Open" Tag="{Binding}" Margin="16,0,0,0" Click="OpenSite_OnClick" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}" />
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Host}" Margin="0,4,0,0" Style="{StaticResource Description}" /></StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoSitesText" Text="No sites match that filter." Style="{StaticResource Description}" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="AccessPage" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="A deliberate exception" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Temporary access lets you visit a place outside your Sphere after two password challenges separated by a waiting period." Margin="0,10,0,0" Style="{StaticResource Description}" />
                            <TextBlock x:Name="AccessStatusText" Margin="0,20,0,0" Style="{StaticResource Description}" />
                            <Button x:Name="SetupPasswordButton" Content="Set up access password" HorizontalAlignment="Left" Margin="0,20,0,0" Visibility="Collapsed" Click="SetupPassword_OnClick" />
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Request a deliberate visit" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Enter a website address, such as example.com. HTTPS is added automatically when omitted. This is not a search: continuing opens the password challenge, not the website. Nothing is added to your Sphere." Style="{StaticResource Description}" Margin="0,10,0,16" />
                            <Label Content="Website address" Target="{Binding ElementName=AccessAddress}" Foreground="{DynamicResource ZenithTextBrush}" Padding="0,0,0,8" />
                            <TextBox x:Name="AccessAddress" Padding="12" Background="{DynamicResource ZenithRaisedSurfaceBrush}" Foreground="{DynamicResource ZenithTextBrush}" BorderBrush="{DynamicResource ZenithInteractiveBorderBrush}" CaretBrush="{DynamicResource ZenithAccentBrush}" AutomationProperties.Name="Website address for temporary access" KeyDown="AccessAddress_OnKeyDown" TextChanged="AccessAddress_OnTextChanged" />
                            <Button x:Name="BeginAccessButton" Content="Continue to access request" HorizontalAlignment="Left" Margin="0,16,0,0" Click="BeginAccess_OnClick" />
                            <TextBlock x:Name="AccessAddressFeedback" Style="{StaticResource Description}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel></Border>
                        <TextBlock Text="Your pending requests" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,16" />
                        <TextBlock x:Name="NoPendingRequests" Text="No pending requests. Use the address field above to begin a deliberate visit." Style="{StaticResource Description}" />
                        <ItemsControl x:Name="PendingRequests">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Resume" Tag="{Binding}" Margin="12,0,0,0" Click="ResumeAccess_OnClick" />
                                        <StackPanel><TextBlock Text="{Binding Host}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Margin="0,6,0,0" Style="{StaticResource Description}" /></StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="VaultPage" Visibility="Collapsed">
                        <settings:VaultPanel x:Name="VaultEditor" />
                    </StackPanel>
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Advertising &amp; cosmetic filtering" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="EasyList and EasyPrivacy filter advertising and tracking requests and hide matching page elements, including in embedded frames. No social-blocking list is enabled. Filter exceptions never override the permanent Blacklist." Style="{StaticResource Description}" Margin="0,12,0,0" />
                            <TextBlock x:Name="AdblockStatusText" Style="{StaticResource Description}" Margin="0,12,0,0" />
                            <TextBlock Text="Some video ads and anti-adblock systems need scriptlets or advanced rules, which are not enabled yet. Reload a page to apply updated cosmetic rules. List issues can be reported at github.com/easylist/easylist/issues; do not include private URLs or account information." Style="{StaticResource Description}" Margin="0,12,0,0" />
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Permanent Blacklist &amp; host filtering" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="StevenBlack unified hosts + fake-news, gambling and porn. Social-media extension excluded. Updates daily; no Vault override or disable switch. Listed hosts are blocked even inside Sphere pages. Host filtering does not remove every ad." Style="{StaticResource Description}" Margin="0,12,0,0" />
                            <TextBlock x:Name="BlacklistStatusText" Style="{StaticResource Description}" Margin="0,12,0,0" />
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Zenith" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ZenithAccentBrush}" />
                            <TextBlock Text="A calm place for your Internet." Margin="0,12,0,0" FontSize="18" />
                            <TextBlock Text="Your Sphere brings your chosen destinations together. Every destination is checked before a page opens." Margin="0,12,0,0" Style="{StaticResource Description}" />
                            <TextBlock x:Name="VersionText" Margin="0,20,0,0" Style="{StaticResource Description}" />
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="A few useful shortcuts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="Ctrl + K     Find in your Sphere" Style="{StaticResource Description}" Margin="0,4" />
                            <TextBlock Text="Ctrl + L     Inspect or edit the address" Style="{StaticResource Description}" Margin="0,4" />
                            <TextBlock Text="Ctrl + T     Open a new tab" Style="{StaticResource Description}" Margin="0,4" />
                            <TextBlock Text="Ctrl + W     Close the current tab" Style="{StaticResource Description}" Margin="0,4" />
                            <TextBlock Text="Ctrl + D     Bookmark the current page" Style="{StaticResource Description}" Margin="0,4" />
                        </StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock x:Name="SaveStatus" Grid.Row="2" Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource ZenithMutedTextBrush}" Text="Preferences are saved on this device." AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Grid>
</Window>
