        <Style x:Key="SidebarIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ZenithMutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenithHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ZenithHighlightForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenithRaisedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ZenithFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.34" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTextButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ZenithMutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenithHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ZenithTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenithRaisedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ZenithFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BookmarkIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{DynamicResource ZenithSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ZenithAccentBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SlimScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface"
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ZenithInteractiveBorderBrush}"
                                CornerRadius="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ZenithAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ZenithAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource ZenithAccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ZenithAccentForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenithAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ZenithAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ZenithFocusOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ZenithWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar"
                Grid.Column="0"
                Padding="12,14,12,12"
                Background="{DynamicResource ZenithChromeBrush}"
                BorderBrush="{DynamicResource ZenithBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="38" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HomeButton"
                            Grid.Column="0"
                            Style="{StaticResource SidebarTextButtonStyle}"
                            Width="38"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="{DynamicResource ZenithAccentBrush}"
                            Content="Z"
                            ToolTip="Your Sphere"
                            AutomationProperties.Name="Go to your Sphere"
                            Click="HomeButton_OnClick" />
                    <Button x:Name="CollapseSidebarButton"
                            Grid.Column="1"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Margin="0"
                            Content="&#xE76B;"
                            ToolTip="Collapse sidebar"
                            AutomationProperties.Name="Collapse sidebar"
                            Click="CollapseSidebarButton_OnClick" />
                </Grid>

                <StackPanel x:Name="NavigationButtonsPanel"
                            Grid.Row="1"
                            Margin="0,0,0,12"
                            Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Content="&#xE72B;"
                            IsEnabled="False"
                            ToolTip="Back (Alt+Left)"
                            AutomationProperties.Name="Back"
                            Click="BackButton_OnClick" />
                    <Button x:Name="ForwardButton"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Content="&#xE72A;"
                            IsEnabled="False"
                            ToolTip="Forward (Alt+Right)"
                            AutomationProperties.Name="Forward"
                            Click="ForwardButton_OnClick" />
                    <Button x:Name="ReloadButton"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Content="&#xE72C;"
                            IsEnabled="False"
                            ToolTip="Reload (F5)"
                            AutomationProperties.Name="Reload"
                            Click="ReloadButton_OnClick" />
                    <Button x:Name="BookmarkButton"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Content="&#xE734;"
                            IsEnabled="False"
                            ToolTip="Bookmark this page (Ctrl+D)"
                            AutomationProperties.Name="Bookmark this page"
                            Click="BookmarkButton_OnClick" />
                </StackPanel>

                <Button x:Name="CurrentSiteButton"
                        Grid.Row="2"
                        Style="{StaticResource SidebarTextButtonStyle}"
                        Margin="0,0,0,10"
                        ToolTipService.ShowDuration="30000"
                        Visibility="Collapsed"
                        Click="CurrentSiteButton_OnClick">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="CurrentSiteIcon"
                                   DockPanel.Dock="Left"
                                   Width="22"
                                   Margin="0,0,9,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource ZenithAccentBrush}"
                                   Text="&#xE774;" />
                        <TextBlock x:Name="CurrentSiteText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ZenithTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>

                <Grid Grid.Row="3" Margin="0,0,0,18">
                    <Border x:Name="SphereSearchContainer"
                            Height="40"
                            Padding="11,0"
                            Background="{DynamicResource ZenithSurfaceBrush}"
                            BorderBrush="{DynamicResource ZenithBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource ZenithAccentBrush}"
                                       Text="&#xE721;" />
                            <TextBox x:Name="SphereSearchTextBox"
                                     Grid.Column="1"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource ZenithTextBrush}"
                                     FontSize="13"
                                     Foreground="{DynamicResource ZenithTextBrush}"
                                     SelectionBrush="{DynamicResource ZenithAccentPressedBrush}"
                                     AutomationProperties.Name="Find in your Sphere"
                                     TextChanged="SphereSearchTextBox_OnTextChanged"
                                     GotKeyboardFocus="SphereSearchTextBox_OnGotKeyboardFocus"
                                     LostKeyboardFocus="SphereSearchTextBox_OnLostKeyboardFocus"
                                     KeyDown="SphereSearchTextBox_OnKeyDown" />
                            <TextBlock x:Name="SphereSearchPlaceholder"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Foreground="{DynamicResource ZenithMutedTextBrush}"
                                       Text="Find in your Sphere" />
                        </Grid>
                    </Border>
                    <Button x:Name="CollapsedSearchButton"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Margin="0"
                            HorizontalAlignment="Center"
                            Content="&#xE721;"
                            ToolTip="Find in your Sphere (Ctrl+K)"
                            AutomationProperties.Name="Find in your Sphere"
                            Visibility="Collapsed"
                            Click="CollapsedSearchButton_OnClick" />
                    <Popup x:Name="SphereResultsPopup"
                           PlacementTarget="{Binding ElementName=SphereSearchContainer}"
                           Placement="Bottom"
                           VerticalOffset="6"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="True">
                        <Border Width="224"
                                Padding="8"
                                Background="{DynamicResource ZenithChromeBrush}"
                                BorderBrush="{DynamicResource ZenithInteractiveBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SphereResultsHeadingTextBlock"
                                           Margin="8,5,8,8"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ZenithTextBrush}"
                                           Text="Your Sphere" />
                                <ScrollViewer Grid.Row="1"
                                              MaxHeight="380"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SphereResultsPanel" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="2"
                                           Margin="8,8,8,4"
                                           FontSize="10"
                                           Foreground="{DynamicResource ZenithSubtleTextBrush}"
                                           Text="Select a place to open it · star to save" />
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <TextBlock x:Name="BookmarksSectionLabel"
                               Margin="8,0,0,8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ZenithSubtleTextBrush}"
                               Text="BOOKMARKS" />
                    <Grid MaxHeight="140">
                        <ScrollViewer x:Name="BookmarkScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      PreviewMouseWheel="BookmarkScrollViewer_OnPreviewMouseWheel"
                                      ScrollChanged="BookmarkScrollViewer_OnScrollChanged">
                            <UniformGrid x:Name="BookmarkGrid" Columns="3">
                                <Button x:Name="AddBookmarkButton"
                                        Style="{StaticResource BookmarkIconButtonStyle}"
                                        Content="+"
                                        ToolTip="Add a bookmark"
                                        AutomationProperties.Name="Add a bookmark"
                                        Click="AddBookmarkButton_OnClick" />
                            </UniformGrid>
                        </ScrollViewer>
                        <ScrollBar x:Name="BookmarkOverlayScrollBar"
                                   Style="{StaticResource SlimVerticalScrollBarStyle}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch"
                                   Orientation="Vertical"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"
                                   ValueChanged="BookmarkOverlayScrollBar_OnValueChanged" />
                    </Grid>
                </StackPanel>

                <Border x:Name="TabsRow" Grid.Row="5" MinHeight="0" Margin="4,0,4,8" BorderBrush="{DynamicResource ZenithBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TabsSectionLabel"
                                   Margin="8,0,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ZenithSubtleTextBrush}"
                                   Text="OPEN TABS" />
                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="280"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OpenTabsPanel" />
                        </ScrollViewer>
                        <Button x:Name="NewTabButton"
                                Grid.Row="2"
                                Style="{StaticResource SidebarTextButtonStyle}"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="New tab"
                                Click="NewTabButton_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NewTabIcon" Width="22" Margin="0,0,9,0" HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource ZenithMutedTextBrush}" Text="+" />
                                <TextBlock x:Name="NewTabText" VerticalAlignment="Center" Text="New tab" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Button x:Name="SettingsButton"
                        Grid.Row="6"
                        Style="{StaticResource SidebarTextButtonStyle}"
                        AutomationProperties.Name="Settings and application menu"
                        ToolTip="Settings and application menu"
                        Click="OpenSettingsMenu_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SettingsButtonIcon" Width="22" Margin="0,0,9,0" HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE713;" />
                        <TextBlock x:Name="SettingsButtonText" VerticalAlignment="Center" Text="Settings" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Settings" Click="SettingsMenuItem_OnClick" />
                            <MenuItem Header="Bookmarks" Click="BookmarksMenuItem_OnClick" />
                            <MenuItem Header="Vault" ToolTip="The Vault is not available yet" Click="VaultMenuItem_OnClick" />
                            <Separator />
                            <MenuItem Header="About Zenith" Click="AboutMenuItem_OnClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource ZenithAmbientBrush}">
            <Grid x:Name="BrowserHost">
                <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="StartSurface" Background="{DynamicResource ZenithAmbientBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                    <Border Width="72" Height="72" HorizontalAlignment="Center" Background="{DynamicResource ZenithSurfaceBrush}" BorderBrush="{DynamicResource ZenithBorderBrush}" BorderThickness="1" CornerRadius="24">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource ZenithAccentBrush}" Text="Z" />
                    </Border>
                    <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Your Sphere" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="15" Foreground="{DynamicResource ZenithMutedTextBrush}" Text="A calm place to begin." />
                </StackPanel>
            </Grid>

            <Grid x:Name="BoundarySurface"
                  Background="{DynamicResource ZenithWindowBrush}"
                  AutomationProperties.LiveSetting="Assertive"
                  Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center">
                    <Border MaxWidth="620"
                            Margin="48,32"
                            Padding="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ZenithSurfaceBrush}"
                            BorderBrush="{DynamicResource ZenithBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel>
                            <Border Width="46" Height="46" HorizontalAlignment="Left" Background="{DynamicResource ZenithRaisedSurfaceBrush}" CornerRadius="14">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource ZenithAccentBrush}" Text="&#xE946;" />
                            </Border>
                            <TextBlock x:Name="BoundaryHeadingTextBlock" Margin="0,22,0,0" FontSize="28" FontWeight="SemiBold" Text="This destination is not available" />
                            <TextBlock x:Name="BoundaryExplanationTextBlock" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="23" FontSize="15" Foreground="{DynamicResource ZenithMutedTextBrush}" />
                            <Border Margin="0,24,0,0" Padding="16,13" Background="{DynamicResource ZenithRaisedSurfaceBrush}" BorderBrush="{DynamicResource ZenithBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ZenithSubtleTextBrush}" Text="REQUESTED ADDRESS" />
                                    <TextBlock x:Name="BoundaryTargetTextBlock" Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource ZenithTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,28,0,0" Orientation="Horizontal">
                                <Button x:Name="ReturnToSphereButton" Style="{StaticResource PrimaryButtonStyle}" Content="Return to your Sphere" AutomationProperties.Name="Return to your Sphere" Click="ReturnToSphereButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <Border x:Name="NoticeBar"
                    Margin="18"
                    Padding="14,10,8,10"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ZenithRaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource ZenithInteractiveBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Width="34"
                            Height="34"
                            Margin="12,0,0,0"
                            Content="&#xE711;"
                            ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss message"
                            Click="DismissNoticeButton_OnClick" />
                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="2,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource ZenithAccentBrush}" />
                    <TextBlock x:Name="NoticeTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ZenithMutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
